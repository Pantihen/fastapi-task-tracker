# Переменные окружения для docker compose.
# Внутри Docker-сети сервисы доступны по ИМЕНАМ (db, redis), а не по localhost:
# localhost в контейнере app — это сам контейнер app.
# Значения ниже — только для локального запуска. На сервере задаются свои.

# --- PostgreSQL (используется и сервисом db, и приложением) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=task_tracker
DATABASE_URL=postgresql+psycopg://app:app_password@db:5432/task_tracker

# --- Redis (брокер и хранилище результатов Celery) ---
REDIS_URL=redis://redis:6379

# --- Приложение ---
SECRET_KEY=docker-local-secret-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOGIN_RATE_LIMIT=5/minute
EMAIL_SEND_DELAY_SECONDS=5

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
